{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/codex-hooks-workshop/07-compaction/hook.py\"",
            "timeout": 5
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/codex-hooks-workshop/07-compaction/hook.py\"",
            "timeout": 5
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/codex-hooks-workshop/07-compaction/hook.py\"",
            "timeout": 5
          }
        ],
        "matcher": "^compact$"
      }
    ]
  }
}
