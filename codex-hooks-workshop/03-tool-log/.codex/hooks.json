{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/codex-hooks-workshop/03-tool-log/hook.py\"",
            "timeout": 5,
            "statusMessage": "Recording command completion"
          }
        ]
      }
    ]
  }
}
